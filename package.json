{
  "name": "anytts",
  "version": "0.2.0",
  "description": "Text-to-speech for the browser and Node with pluggable engines — starting with the free Edge read-aloud service.",
  "type": "module",
  "license": "MIT",
  "author": "Greg Motyl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmotyl/anytts.git"
  },
  "homepage": "https://github.com/gmotyl/anytts#readme",
  "bugs": "https://github.com/gmotyl/anytts/issues",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.18.1",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./text": {
      "types": "./dist/text/index.d.ts",
      "import": "./dist/text/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run --project node --project jsdom --project package",
    "test:live": "vitest run --project live",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
